PORT=5000
MONGODB_URI=mongodb://localhost:27017/aussieDB
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production

# Payment Gateway Operating Mode: 'production' | 'sandbox' | 'simulation'
# Set PAYMENT_MODE=production for live ANZ Worldline processing.
PAYMENT_MODE=production

# ANZ Worldline Payment Gateway Credentials
ANZ_ENVIRONMENT=production
ANZ_MERCHANT_ID=your_production_merchant_id
ANZ_API_KEY=your_production_api_key_id
ANZ_API_SECRET=your_production_secret_api_key
ANZ_API_ENDPOINT=https://payment.anzworldline-solutions.com.au/
ANZ_WEBHOOK_SECRET=your_production_webhook_secret

# Secondary Configuration Aliases (Optional)
ANZ_WORLDLINE_ENVIRONMENT=production
ANZ_WORLDLINE_MERCHANT_ID=your_production_merchant_id
ANZ_WORLDLINE_API_KEY=your_production_api_key_id
ANZ_WORLDLINE_API_SECRET=your_production_secret_api_key
ANZ_WORLDLINE_API_ENDPOINT=https://payment.anzworldline-solutions.com.au/
ANZ_WORLDLINE_WEBHOOK_SECRET=your_production_webhook_secret

