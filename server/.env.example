PORT=5000
MONGODB_URI=mongodb://localhost:27017/aussieDB
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production

# ANZ Worldline Payment Gateway Configuration
ANZ_ENV=production
ANZ_MERCHANT_ID=your_merchant_id_here
ANZ_API_KEY=your_api_key_here
ANZ_API_SECRET=your_api_secret_here
ANZ_API_ENDPOINT=https://payment.anzworldline-solutions.com.au/

# Secondary Aliases
ANZ_WORLDLINE_ENVIRONMENT=production
ANZ_WORLDLINE_MERCHANT_ID=your_merchant_id_here
ANZ_WORLDLINE_API_KEY=your_api_key_here
ANZ_WORLDLINE_API_SECRET=your_api_secret_here
ANZ_WORLDLINE_API_ENDPOINT=https://payment.anzworldline-solutions.com.au/
ANZ_WORLDLINE_WEBHOOK_SECRET=your_webhook_secret_here
