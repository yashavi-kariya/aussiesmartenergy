PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
NODE_ENV=production

# Default Admin Credentials (used by seed script)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aussiesmartenergy.com.au
ADMIN_PASSWORD=Admin123!

# Google Places API Configuration
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_BUSINESS_URL=
GOOGLE_WRITE_REVIEW_URL=

# ANZ Worldline Payment Gateway Configuration
ANZ_ENVIRONMENT=production
ANZ_MERCHANT_ID=
ANZ_API_KEY=
ANZ_API_SECRET=
ANZ_API_ENDPOINT=payment.anzworldline-solutions.com.au
PAYMENT_MODE=production

# Cloudinary Storage Configuration (Permanent Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
